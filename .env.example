# Spotify Web API credentials (Phase 6).
# Copy this file to `.env` and fill in the values from your Spotify developer app:
#   https://developer.spotify.com/dashboard  ->  your app  ->  Settings.
# `.env` is gitignored — never commit real secrets.
#
# The Redirect URI below must be added to the app's "Redirect URIs" list EXACTLY.
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: country code for track availability filtering (default: CA).
# SPOTIFY_MARKET=CA
